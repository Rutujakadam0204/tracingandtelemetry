        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Web CPU vs request rate",
      "description": "If CPU rises together with requests, the web process is CPU-bound for this load.",
