    {
      "id": 5,
      "type": "stat",
      "title": "Busiest Celery process",
      "description": "The single worker process using the most CPU. A Python process can't use much more than 100% (one core) because of the GIL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(sum by (instance) (rate(process_cpu_time_seconds_total{job=\"task-manager-worker\"}[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
